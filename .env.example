# Copy to .env.local and fill in from your Supabase dashboard:
# Project Settings -> API (URL + anon/public key). Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional (currently unused; AI will move to Supabase Edge Functions, NOT the client)
# EXPO_PUBLIC_OPENAI_API_KEY=
